# =========================================================================
# GITIGNORE PERFEITO PARA BLAZOR WASM STANDALONE (.NET 10 - SETEMBRO/2026)
# =========================================================================

# -------------------------------------------------------------------------
# 1. Compilação e Saídas do .NET (.NET Core / .NET 10)
# -------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
# Ignora arquivos de publicação gerados localmente
[Pp]ublish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml

# -------------------------------------------------------------------------
# 2. Especificidades do Blazor WebAssembly & Web (AOT / Emscripten)
# -------------------------------------------------------------------------
# Ferramentas de Build WebAssembly do .NET (Emscripten / Native dependencies)
.emscripten
*.o
*.a
*.bc
*.wasm
# Nota: Não ignore os arquivos estáticos legítimos do seu wwwroot, apenas o cache local de ferramentas
!wwwroot/_framework/

# Opcional: Descomente se não quiser subir arquivos pré-comprimidos gerados pelo Build local
# (Geralmente os serviços de hospedagem como GitHub Pages geram sua própria compressão)
# _framework/*.br
# _framework/*.gz

# -------------------------------------------------------------------------
# 3. Configurações de Ambiente (Segurança em Apps Standalone)
# -------------------------------------------------------------------------
# Arquivos de configurações locais de desenvolvimento que contêm chaves de API/Configurações
wwwroot/appsettings.Development.json
wwwroot/appsettings.Local.json

# Se você estiver usando secrets do usuário para desenvolvimento local
# (Embora WASM Standalone leia do appsettings, o MSBuild pode usar secrets)
[Cc]onnecting[Ss]trings.json
[Ee]nvironment[Vv]ariables.json

# -------------------------------------------------------------------------
# 4. Ferramentas de Desenvolvimento e IDEs (Edição 2026)
# -------------------------------------------------------------------------
# Visual Studio 2022 / Visual Studio 2026
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio Code (C# Dev Kit e extensões modernas)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace

# Rider / JetBrains IDEs
.idea/
*.sln.iml

# -------------------------------------------------------------------------
# 5. Gerenciadores de Pacotes (Ecossistema Web)
# -------------------------------------------------------------------------
# Se você usa ferramentas como Tailwind, SASS ou pacotes npm junto ao Blazor
node_modules/
/package-lock.json
/yarn.lock
/pnpm-lock.yaml
.sass-cache/
.eslintcache

# Pacotes NuGet (restaurados dinamicamente)
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# -------------------------------------------------------------------------
# 6. Sistema Operacional e Logs
# -------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Logs do sistema e de crash do .NET
*.log
*.crash
