<Window x:Class="CryptoWalletAnalyzer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CryptoWalletAnalyzer.UI.ViewModels"
        mc:Ignorable="d"
        Title="Crypto Wallet Analyzer — Local PC Inventory &amp; Security Audit"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Color Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0F1117"/>
        <SolidColorBrush x:Key="BgCard" Color="#181B26"/>
        <SolidColorBrush x:Key="BorderCard" Color="#282D3F"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>

        <!-- Stat Card Style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#374151"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Outline Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#374151"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#181B26"/>
            <Setter Property="AlternatingRowBackground" Value="#141722"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#252A3D"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1F2433"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Metric Cards -->
            <RowDefinition Height="Auto"/> <!-- Search & Controls Toolbar -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Status & Safety Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header with Safety Badge -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Crypto Wallet Analyzer" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Local PC Inventory &amp; Safe Auditing Tool for Windows (.NET 8 LTS)" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Safety Guarantee Badge -->
            <Border Grid.Column="1" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛡️ " FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="ZERO PRIVATE DATA ACCESS" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                        <TextBlock Text="Strictly Read-Only Metadata Inspection" FontSize="10" Foreground="#A7F3D0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Wallets -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="TOTAL DETECTED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding TotalWalletsCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                    <TextBlock Text="Across all vectors" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Active Processes -->
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="ACTIVE PROCESSES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding ActiveProcessesCount}" FontSize="26" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0"/>
                    <TextBlock Text="Currently running on PC" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Browser Extensions -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="BROWSER EXTENSIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding BrowserExtensionsCount}" FontSize="26" FontWeight="Bold" Foreground="#60A5FA" Margin="0,4,0,0"/>
                    <TextBlock Text="Chrome, Edge, Brave, etc." FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Desktop Applications -->
            <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="DESKTOP APPLICATIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding DesktopAppsCount}" FontSize="26" FontWeight="Bold" Foreground="#C084FC" Margin="0,4,0,0"/>
                    <TextBlock Text="Exodus, Ledger, Trezor, etc." FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Search & Control Toolbar -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Scan Button -->
                <Button Grid.Column="0" Command="{Binding StartScanCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍 " FontSize="13"/>
                        <TextBlock Text="Start Deep Scan"/>
                    </StackPanel>
                </Button>

                <!-- Cancel Button -->
                <Button Grid.Column="1" Command="{Binding CancelScanCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,14,0"
                        IsEnabled="{Binding IsScanning}">
                    <TextBlock Text="Cancel"/>
                </Button>

                <!-- Live Search Box -->
                <Border Grid.Column="2" Background="#10121A" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔎 " Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center"
                                 FontSize="13"/>
                    </Grid>
                </Border>

                <!-- Category Filter ComboBox -->
                <ComboBox Grid.Column="3" SelectedValue="{Binding SelectedCategoryFilter}" SelectedValuePath="Content"
                          Background="#1F2937" Foreground="Black" Width="150" Margin="0,0,10,0" VerticalAlignment="Center">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Browser Extensions"/>
                    <ComboBoxItem Content="Desktop Apps"/>
                </ComboBox>

                <!-- Export JSON Button -->
                <Button Grid.Column="4" Command="{Binding ExportJsonCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                    <TextBlock Text="Export JSON"/>
                </Button>

                <!-- Export CSV Button -->
                <Button Grid.Column="5" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}">
                    <TextBlock Text="Export CSV"/>
                </Button>
            </Grid>
        </Border>

        <!-- 4. Inventory DataGrid -->
        <Border Grid.Row="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8">
            <DataGrid ItemsSource="{Binding FilteredItems}">
                <DataGrid.Columns>
                    <!-- Name & Logo Indicator -->
                    <DataGridTextColumn Header="Wallet Name" Binding="{Binding Name}" Width="160" FontWeight="SemiBold"/>

                    <!-- Category -->
                    <DataGridTemplateColumn Header="Category" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding CategoryDisplay}" FontSize="11" Foreground="#93C5FD"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status (Active / Installed) -->
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="#34D399"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Version -->
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90"/>

                    <!-- Location / Browser -->
                    <DataGridTextColumn Header="Host / Profile" Binding="{Binding LocationDisplay}" Width="180"/>

                    <!-- Install Date -->
                    <DataGridTextColumn Header="Installed Date" Binding="{Binding InstallDateDisplay}" Width="140"/>

                    <!-- Path -->
                    <DataGridTextColumn Header="Inspection Target" Binding="{Binding Path}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 5. Status & Safety Footer -->
        <Border Grid.Row="4" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    <ProgressBar IsIndeterminate="{Binding IsScanning}" Height="3" Margin="0,6,0,0"
                                 Background="#1F2937" Foreground="{StaticResource AccentBlue}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Last Scan: " FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center">
                    <Run Text="{Binding LastScanDuration}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
